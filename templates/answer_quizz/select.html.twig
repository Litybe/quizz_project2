{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/universal-card.css') }}">
{% endblock %}

{% block body %}
    <h1>Sélectionner un Quiz</h1>

    {% include '_search_filters.html.twig' with {
        searchPlaceholder: "Rechercher un quiz...",
        searchFunction: "searchQuizzes",
        itemType: "quiz",
        defaultRoute: 'selectAll_quizz'
    } %}

    <form method="get" action="{{ path('answer_quizz') }}" class="quiz-form" id="quizForm">
        <input type="hidden" name="id" id="quizId">
    </form>

    <div class="quiz-grid" id="quizGrid">
        {% for quiz in quizzes %}
            <div class="quiz-card-wrapper">
                {% include 'partials/_quiz_card.html.twig' with {
                    quiz: quiz,
                    userQuizzStatuses: userQuizzStatuses,
                    userScores: userScores,
                    userRankings: userRankings,
                    bestScores: bestScores
                } %}
            </div>
        {% endfor %}
    </div>

    <div class="pagination">
        {% if quizzes.getTotalItemCount > 10 %}
            {% if page > 1 %}
                <a href="{{ path('selectAll_quizz', {'page': page - 1}) }}" class="pagination-link">&laquo; Précédent</a>
            {% endif %}

            {% for p in 1..totalPages %}
                <a href="{{ path('selectAll_quizz', {'page': p}) }}" class="pagination-link {% if p == page %}active{% endif %}">{{ p }}</a>
            {% endfor %}

            {% if page < totalPages %}
                <a href="{{ path('selectAll_quizz', {'page': page + 1}) }}" class="pagination-link">Suivant &raquo;</a>
            {% endif %}
        {% endif %}
    </div>

    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
        }

        h1 {
            text-align: center;
            color:rgb(83, 119, 155);
            margin-bottom: 30px;
            font-weight: bold;
            font-size: 28px;
        }

        .section-title {
            color: #ff961e;
            text-align: center;
            font-weight: bold;
            margin-bottom: 20px;
            font-size: 20px;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
        }

        .quiz-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
            max-width: 1200px;
            margin: 0 auto 40px auto;
            padding: 0 20px;
        }

        .quiz-card-wrapper {
            display: flex;
            justify-content: center;
        }

        .quiz-card {
            width: 100%;
            max-width: 220px;
            margin: 0;
        }

        .quiz-card h3 {
            color: #2c3e50;
        }

        .quiz-tags {
            margin-top: 10px;
        }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-top: 30px;
            flex-wrap: wrap;
        }

        .pagination-link {
            padding: 8px 12px;
            text-decoration: none;
            color: #2c3e50;
            border: 1px solid #ddd;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .pagination-link:hover {
            background-color: #f8f9fa;
            border-color: #ff961e;
        }

        .pagination-link.active {
            background-color: #ff961e;
            color: white;
            border-color: #ff961e;
        }

        /* Responsive design pour les petits écrans */
        @media (max-width: 1200px) {
            .quiz-grid {
                grid-template-columns: repeat(4, 1fr);
                max-width: 1000px;
            }
        }

        @media (max-width: 900px) {
            .quiz-grid {
                grid-template-columns: repeat(3, 1fr);
                max-width: 800px;
            }
        }

        @media (max-width: 600px) {
            .quiz-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 15px;
                padding: 0 15px;
            }
        }

        @media (max-width: 400px) {
            .quiz-grid {
                grid-template-columns: 1fr;
                gap: 15px;
            }
        }
    </style>

    <script>
        function selectQuiz(quizId) {
            document.getElementById('quizId').value = quizId;
            document.getElementById('quizForm').submit();
        }

        function searchQuizzes() {
            let input = document.getElementById('searchInput');
            let filter = input.value.toUpperCase();
            let grid = document.getElementById('quizGrid');
            let cards = grid.getElementsByClassName('quiz-card-wrapper');

            for (let i = 0; i < cards.length; i++) {
                let title = cards[i].getElementsByTagName('h3')[0];
                if (title.innerHTML.toUpperCase().indexOf(filter) > -1) {
                    cards[i].style.display = "";
                } else {
                    cards[i].style.display = "none";
                }
            }
        }
    </script>
{% endblock %}
