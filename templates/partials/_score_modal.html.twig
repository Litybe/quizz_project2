{# Modal pour afficher le score du quiz #}
<div id="scoreModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="modal-title">🎉 Quiz Terminé !</h2>
            <span class="close">&times;</span>
        </div>
        <div class="modal-body">
            <div class="score-display">
                <div class="score-circle">
                    <span id="scoreNumber">0</span>
                    <span class="score-max">/100</span>
                </div>
                <div class="score-label">Votre Score</div>
            </div>
            <div id="scoreText" class="score-message">Félicitations !</div>
            
            {# Section d'invitation à la connexion pour les utilisateurs non connectés #}
            <div id="guestLoginSection" class="guest-login-section" style="display: none;">
                <div class="login-invitation">
                    <div class="login-icon">🔐</div>
                    <h3>Connectez-vous pour sauvegarder votre score !</h3>
                    <p>Votre score actuel est temporaire. Créez un compte ou connectez-vous pour :</p>
                    <ul class="benefits-list">
                        <li>✅ Sauvegarder vos scores</li>
                        <li>🏆 Apparaître dans les classements</li>
                        <li>📊 Suivre vos progrès</li>
                        <li>🎯 Défier vos amis</li>
                    </ul>
                    <div class="login-actions">
                        <a href="{{ path('faceit_login') }}" class="btn-login">🔑 Se connecter avec Faceit</a>
                        <a href="{{ path('app_home') }}" class="btn-register">📝 En savoir plus</a>
                    </div>
                </div>
            </div>
            
            {# Section de confirmation de sauvegarde du score temporaire #}
            <div id="tempScoreSavedSection" class="temp-score-saved-section" style="display: none;">
                <div class="score-saved-confirmation">
                    <div class="saved-icon">🎉</div>
                    <h3>Score sauvegardé avec succès !</h3>
                    <p>Votre score temporaire a été sauvegardé dans votre profil.</p>
                    <div class="saved-score-info">
                        <span class="saved-score-label">Score sauvegardé :</span>
                        <span id="savedScoreNumber" class="saved-score-value">0</span>
                        <span class="saved-score-max">/100</span>
                    </div>
                </div>
            </div>
            
            <div class="score-actions">
                <button class="btn-retry" onclick="window.retryQuiz()" type="button">🔄 Réessayer</button>
                <button class="btn-home" onclick="window.goHome()" type="button">🏠 Retour à l'accueil</button>
            </div>
        </div>
    </div>
</div>

<style>
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(5px);
        animation: fadeIn 0.3s ease-out;
    }
    
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    .modal-content {
        background: linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%);
        margin: 5% auto;
        padding: 0;
        border-radius: 20px;
        width: 90%;
        max-width: 500px;
        text-align: center;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        animation: slideIn 0.4s ease-out;
        position: relative;
        overflow: hidden;
        border: 3px solid #ff6b35;
    }
    
    @keyframes slideIn {
        from { 
            transform: translateY(-50px);
            opacity: 0;
        }
        to { 
            transform: translateY(0);
            opacity: 1;
        }
    }
    
    .modal-header {
        background: linear-gradient(135deg, #ff6b35 0%, #e55a2b 100%);
        padding: 25px 30px 20px;
        position: relative;
    }
    
    .modal-title {
        color: white;
        font-size: 26px;
        font-weight: 700;
        margin: 0;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    }
    
    .modal-body {
        padding: 30px;
    }
    
    .score-display {
        margin-bottom: 25px;
    }
    
    .score-circle {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        box-shadow: 0 8px 25px rgba(255, 107, 53, 0.3);
        position: relative;
    }
    
    .score-circle::before {
        content: '';
        position: absolute;
        top: -3px;
        left: -3px;
        right: -3px;
        bottom: -3px;
        background: linear-gradient(135deg, #ff6b35, #ff8c42);
        border-radius: 50%;
        z-index: -1;
        opacity: 0.3;
    }
    
    #scoreNumber {
        color: white;
        font-size: 36px;
        font-weight: 800;
        line-height: 1;
    }
    
    .score-max {
        color: rgba(255, 255, 255, 0.8);
        font-size: 18px;
        font-weight: 600;
    }
    
    .score-label {
        color: #666;
        font-size: 16px;
        font-weight: 500;
        margin-top: 5px;
    }
    
    .score-message {
        color: #333;
        font-size: 20px;
        font-weight: 600;
        margin: 20px 0 25px;
        padding: 15px 20px;
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        border-radius: 12px;
        border-left: 4px solid #007bff;
    }
    
    .score-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .btn-retry, .btn-home {
        padding: 12px 24px;
        border: none;
        border-radius: 25px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    
    .btn-retry {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3);
    }
    
    .btn-retry:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 123, 255, 0.4);
    }
    
    .btn-retry:active {
        transform: translateY(0);
        box-shadow: 0 2px 10px rgba(0, 123, 255, 0.3);
    }
    
    .btn-home {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
    }
    
    .btn-home:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(40, 167, 69, 0.4);
    }
    
    .btn-home:active {
        transform: translateY(0);
        box-shadow: 0 2px 10px rgba(40, 167, 69, 0.3);
    }
    
    .btn-retry:disabled, .btn-home:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }
    
    /* Styles pour la section d'invitation à la connexion */
    .guest-login-section {
        margin: 25px 0;
        padding: 20px;
        background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
        border-radius: 15px;
        border: 2px solid #ff9800;
        position: relative;
        overflow: hidden;
    }
    
    .guest-login-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #ff9800, #ffc107, #ff9800);
        animation: shimmer 2s infinite;
    }
    
    @keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }
    
    .login-invitation {
        text-align: center;
    }
    
    .login-icon {
        font-size: 48px;
        margin-bottom: 15px;
        animation: bounce 2s infinite;
    }
    
    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-10px); }
        60% { transform: translateY(-5px); }
    }
    
    .login-invitation h3 {
        color: #e65100;
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 15px 0;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }
    
    .login-invitation p {
        color: #795548;
        font-size: 16px;
        margin: 0 0 20px 0;
        line-height: 1.4;
    }
    
    .benefits-list {
        list-style: none;
        padding: 0;
        margin: 0 0 25px 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 10px;
    }
    
    .benefits-list li {
        color: #5d4037;
        font-size: 14px;
        font-weight: 500;
        padding: 8px 12px;
        background: rgba(255, 255, 255, 0.7);
        border-radius: 8px;
        border-left: 3px solid #ff9800;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .login-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .btn-login, .btn-register {
        padding: 12px 24px;
        border: none;
        border-radius: 25px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-width: 140px;
        justify-content: center;
    }
    
    .btn-login {
        background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(255, 152, 0, 0.3);
    }
    
    .btn-login:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 152, 0, 0.4);
    }
    
    .btn-register {
        background: linear-gradient(135deg, #4caf50 0%, #388e3c 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(76, 175, 80, 0.3);
    }
    
    .btn-register:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(76, 175, 80, 0.4);
    }
    
    .btn-login:active, .btn-register:active {
        transform: translateY(0);
    }
    
    /* Responsive design pour la section de connexion */
    @media (max-width: 600px) {
        .benefits-list {
            grid-template-columns: 1fr;
        }
        
        .login-actions {
            flex-direction: column;
            align-items: center;
        }
        
        .btn-login, .btn-register {
            width: 100%;
            max-width: 250px;
        }
    }
    
    .close {
        color: white;
        position: absolute;
        top: 20px;
        right: 25px;
        font-size: 28px;
        font-weight: 300;
        cursor: pointer;
        transition: all 0.2s ease;
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
    }
    
    .close:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: scale(1.1);
    }

    /* Styles pour la section de confirmation de sauvegarde */
    .temp-score-saved-section {
        margin: 25px 0;
        padding: 20px;
        background: linear-gradient(135deg, #e8f5e9 0%, #dcedc8 100%);
        border-radius: 15px;
        border: 2px solid #4caf50;
        position: relative;
        overflow: hidden;
    }

    .temp-score-saved-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #4caf50, #66bb6a, #4caf50);
        animation: shimmer 2s infinite;
    }

    .score-saved-confirmation {
        text-align: center;
    }

    .saved-icon {
        font-size: 48px;
        margin-bottom: 15px;
        animation: bounce 2s infinite;
    }

    .score-saved-confirmation h3 {
        color: #2e7d32;
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 15px 0;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    .score-saved-confirmation p {
        color: #558b2f;
        font-size: 16px;
        margin: 0 0 20px 0;
        line-height: 1.4;
    }

    .saved-score-info {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 15px;
    }

    .saved-score-label {
        color: #2e7d32;
        font-size: 18px;
        font-weight: 600;
    }

    .saved-score-value {
        color: #2e7d32;
        font-size: 24px;
        font-weight: 800;
    }

    .saved-score-max {
        color: rgba(46, 125, 50, 0.8);
        font-size: 16px;
        font-weight: 500;
    }
</style>

<script>
    // Fonctions pour le scoreModal - Rendre globales pour accès depuis le fichier principal
    window.showScoreModal = function(score, title, isGuest = false) {
        const modal = document.getElementById('scoreModal');
        const scoreNumber = document.getElementById('scoreNumber');
        const scoreText = document.getElementById('scoreText');
        const guestLoginSection = document.getElementById('guestLoginSection');
        const tempScoreSavedSection = document.getElementById('tempScoreSavedSection');
        
        // Afficher le score dans le cercle
        scoreNumber.textContent = score;
        
        // Définir le message selon le score
        if (score >= 80) {
            scoreText.textContent = "🎯 Excellent ! Vous maîtrisez parfaitement ce sujet !";
        } else if (score >= 60) {
            scoreText.textContent = "👍 Bien joué ! Vous avez de bonnes connaissances !";
        } else if (score >= 40) {
            scoreText.textContent = "📚 Pas mal ! Continuez à vous améliorer !";
        } else {
            scoreText.textContent = "💪 Courage ! La pratique rend parfait !";
        }
        
        // Afficher ou masquer la section d'invitation à la connexion
        if (guestLoginSection) {
            guestLoginSection.style.display = isGuest ? 'block' : 'none';
        }

        // Afficher ou masquer la section de confirmation de sauvegarde
        if (tempScoreSavedSection) {
            tempScoreSavedSection.style.display = 'none';
        }
        
        modal.style.display = 'block';

        // Gestionnaire pour le bouton de fermeture
        document.querySelector('.close').onclick = function() {
            modal.style.display = 'none';
            window.location.href = "{{ path('selectAll_quizz') }}";
        };

        // Gestionnaire pour fermer en cliquant à l'extérieur
        window.onclick = function(event) {
            if (event.target === modal) {
                modal.style.display = 'none';
                window.location.href = "{{ path('selectAll_quizz') }}";
            }
        };
    };
    
    window.retryQuiz = function() {
        const retryBtn = document.querySelector('.btn-retry');
        const homeBtn = document.querySelector('.btn-home');
        
        // Désactiver les boutons pour éviter les clics multiples
        retryBtn.disabled = true;
        homeBtn.disabled = true;
        retryBtn.textContent = '🔄 Chargement...';
        
        // Fermer le modal d'abord
        document.getElementById('scoreModal').style.display = 'none';
        
        // Attendre un peu pour l'animation, puis recharger
        setTimeout(() => {
            window.location.reload();
        }, 300);
    };
    
    window.goHome = function() {
        const retryBtn = document.querySelector('.btn-retry');
        const homeBtn = document.querySelector('.btn-home');
        
        // Désactiver les boutons pour éviter les clics multiples
        retryBtn.disabled = true;
        homeBtn.disabled = true;
        homeBtn.textContent = '🏠 Redirection...';
        
        // Fermer le modal d'abord
        document.getElementById('scoreModal').style.display = 'none';
        
        // Attendre un peu pour l'animation, puis rediriger
        setTimeout(() => {
            window.location.href = "{{ path('app_home') }}";
        }, 300);
    };

    // Fonction pour afficher la confirmation de sauvegarde du score temporaire
    window.showTempScoreSaved = function(score) {
        const modal = document.getElementById('scoreModal');
        const scoreNumber = document.getElementById('scoreNumber');
        const scoreText = document.getElementById('scoreText');
        const guestLoginSection = document.getElementById('guestLoginSection');
        const tempScoreSavedSection = document.getElementById('tempScoreSavedSection');
        const savedScoreNumber = document.getElementById('savedScoreNumber');
        
        // Afficher le score dans le cercle
        scoreNumber.textContent = score;
        
        // Message de confirmation
        scoreText.textContent = "🎉 Score temporaire sauvegardé !";
        
        // Afficher le score sauvegardé
        if (savedScoreNumber) {
            savedScoreNumber.textContent = score;
        }
        
        // Masquer les sections d'invitation et afficher la confirmation
        if (guestLoginSection) {
            guestLoginSection.style.display = 'none';
        }
        if (tempScoreSavedSection) {
            tempScoreSavedSection.style.display = 'block';
        }
        
        modal.style.display = 'block';

        // Gestionnaire pour le bouton de fermeture
        document.querySelector('.close').onclick = function() {
            modal.style.display = 'none';
            window.location.href = "{{ path('selectAll_quizz') }}";
        };

        // Gestionnaire pour fermer en cliquant à l'extérieur
        window.onclick = function(event) {
            if (event.target === modal) {
                modal.style.display = 'none';
                window.location.href = "{{ path('selectAll_quizz') }}";
            }
        };
    };
</script>
