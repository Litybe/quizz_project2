{# Template partiel pour afficher une carte de quiz #}
{% set onclick_action = '' %}
{% if quiz.id is defined and app.request.get('_route') == 'selectAll_quizz' %}
    {% set onclick_action = 'selectQuiz(' ~ quiz.id ~ ')' %}
{% endif %}

{% set card_status = {} %}
{% if app.user and userQuizzStatuses[quiz.id] is defined and userQuizzStatuses[quiz.id].isDone %}
    {% set card_status = {
        text: 'Terminé',
        class: 'quiz-done'
    } %}
{% else %}
    {% set card_status = {
        text: 'Pas encore terminé',
        class: 'quiz-notdone'
    } %}
{% endif %}

{% set card_scores = {} %}
{% if app.user and userQuizzStatuses[quiz.id] is defined and userQuizzStatuses[quiz.id].isDone and userScores[quiz.id] is defined %}
    {% set card_scores = card_scores|merge({
        user_score: userScores[quiz.id]
    }) %}
    {% if userRankings[quiz.id] is defined %}
        {% set card_scores = card_scores|merge({
            ranking: userRankings[quiz.id]
        }) %}
    {% endif %}
{% endif %}

{% if bestScores[quiz.id] is defined %}
    {% if not (app.user and userScores[quiz.id] is defined and userScores[quiz.id] == bestScores[quiz.id]) %}
        {% set card_scores = card_scores|merge({
            best_score: bestScores[quiz.id]
        }) %}
    {% endif %}
{% endif %}

{% include 'partials/_universal_card.html.twig' with {
    card_type: 'quiz',
    card_icon: 'fas fa-question-circle',
    card_title: quiz.name,
    card_description: quiz.description|default('Pas de description disponible'),
    card_tags: quiz.tags,
    card_status: card_status,
    card_scores: card_scores,
    onclick_action: onclick_action
} %}


