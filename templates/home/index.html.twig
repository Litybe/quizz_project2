{# templates/home/index.html.twig #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <h1 class="welcome-message">Viens tester tes connaissances de CS2</h1>

    <div class="content-container">
        <section class="right-section">
            <h2 class="section-title">Dernier Quiz Mis en Ligne</h2>
            {% if lastQuizz %}
                <a href="{{ path('answer_quizz', {'id': lastQuizz.id}) }}" style="text-decoration: none; color: inherit;">
                    {% include 'partials/_quiz_card.html.twig' with {
                        quiz: lastQuizz,
                        userQuizzStatuses: userQuizzStatuses,
                        userScores: userScores,
                        userRankings: userRankings,
                        bestScores: bestScores
                    } %}
                </a>
            {% else %}
                <p>Aucun quiz disponible pour le moment.</p>
            {% endif %}
        </section>
    </div>

    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
        }

        .welcome-message {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 30px;
            font-weight: bold;
            font-size: 28px;
        }

        .content-container {
            display: flex;
            justify-content: space-between;
            max-width: 1200px;
            margin: 0 auto;
        }

        .left-section, .right-section {
            flex: 1;
            margin: 0 10px; /* Ajoute une marge pour éviter que les sections ne se touchent */
        }

        .section-title {
            color: #ff961e;
            text-align: center;
            font-weight: bold;
            margin-bottom: 20px;
            font-size: 20px;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
        }

        .quiz-card {
            margin: 0 auto; /* Centrer la carte */
            max-width: 300px;
        }

        .quiz-card h3 {
            color: #2c3e50;
        }

        .quiz-tags {
            margin-top: 10px;
        }
        
    </style>
{% endblock %}
